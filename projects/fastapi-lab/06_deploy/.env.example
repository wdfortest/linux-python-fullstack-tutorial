# 复制为 .env 后按需修改；.env 绝不提交 git（.gitignore 已覆盖 .env）
APP_ENV=dev
APP_NAME=fastapi-lab06
APP_DEBUG=true
# 生产示例：mysql+pymysql://bookapp:<password>@127.0.0.1:3306/books
DATABASE_URL=sqlite:///./data/lab06.db
# 生产必须设置（例如 python -c "import secrets; print(secrets.token_hex(32))" 生成）
SECRET_KEY=
LOG_LEVEL=INFO
