name: CI

on:
  push:
    branches: [main]
  pull_request:
    branches: [main]

jobs:
  test:
    runs-on: ubuntu-latest
    strategy:
      matrix:
        python-version: ["3.13", "3.14"]
    steps:
      - uses: actions/checkout@v4

      - name: 设置 Python ${{ matrix.python-version }}
        uses: actions/setup-python@v5
        with:
          python-version: ${{ matrix.python-version }}
          cache: pip

      - name: 安装依赖
        run: |
          python -m pip install --upgrade pip
          pip install fastapi==0.162.0 "uvicorn==0.52.0" pydantic==2.13.4 pytest==9.2.0 httpx==0.28.1

      - name: 运行测试（book-insight API）
        working-directory: projects/book-insight
        run: python -m pytest tests/ -v

      - name: 语法检查全部实验代码
        run: |
          find projects -name "*.py" -not -path "*__pycache__*" -print0 | xargs -0 -n1 python -m py_compile
